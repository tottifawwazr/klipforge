# KlipForge local-development defaults.
# Copy this file to .env before overriding any values. Never commit .env.

COMPOSE_PROJECT_NAME=klipforge
APP_ENV=development
LOG_LEVEL=debug

POSTGRES_DB=klipforge
POSTGRES_USER=klipforge
POSTGRES_PASSWORD=klipforge_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://klipforge:klipforge_dev_password@localhost:5432/klipforge?sslmode=disable

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

API_PORT=8080
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://localhost:8080

# Authentication values are local-development placeholders only. Replace them
# with independently generated secrets in every deployed environment.
JWT_SECRET=local-development-jwt-secret-replace-with-random-64-characters
JWT_ISSUER=klipforge-api
JWT_AUDIENCE=klipforge-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_TOKEN_PEPPER=local-development-refresh-pepper-replace-with-random-64-chars
BCRYPT_COST=12
REFRESH_COOKIE_NAME=klipforge_refresh_token
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW=1m
