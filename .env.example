# KlipForge Phase 1 local-development defaults.
# Copy this file to .env before overriding any values. Never commit .env.

COMPOSE_PROJECT_NAME=klipforge
APP_ENV=development
LOG_LEVEL=debug

POSTGRES_DB=klipforge
POSTGRES_USER=klipforge
POSTGRES_PASSWORD=klipforge_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://klipforge:klipforge_dev_password@localhost:5432/klipforge?sslmode=disable

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

API_PORT=8080
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://localhost:8080
